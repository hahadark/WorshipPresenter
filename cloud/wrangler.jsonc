// 워십프리젠터 웹판 (Cloudflare Worker + Durable Object + D1 + 정적 파일)
// - 정적 파일 public/ 은 `npm run assets` 가 저장소의 web/ 에서 그대로 가져와 만든다 (복사본을 저장소에 두지 않는다).
// - 이 파일은 로컬 개발 · 시험용이다. 실제 배포는 scripts/deploy.mjs 가 D1 id 를 채운 wrangler.preview.jsonc 를 만들어 쓴다.
// - 계약: docs/web/architecture.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worshippresenter-web",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 파일이 있으면 Worker 를 거치지 않고 바로 보낸다 (공개 GPL 코드 · 글꼴 · 아이콘만 들어 있다. 예배 자료 · HTML 은 없다)
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ChurchRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChurchRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worshippresenter-web",
      // 로컬 전용 자리 표시. 배포 때 scripts/deploy.mjs 가 실제 id 로 바꾼 사본을 만든다
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 2단계 C: 그림 · 영상 · 글꼴 (비공개 저장통 — r2.dev · 사용자 도메인 공개 주소는 켜지 않는다. Worker 가 로그인을 본 뒤 내보낸다)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "worshippresenter-web-assets" }],
  "observability": { "enabled": false }
}
