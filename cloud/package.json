{
  "name": "worshippresenter-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "seed": "node scripts/seed.mjs",
    "check": "npm run assets && npm test && wrangler deploy --dry-run --outdir .build",
    "deploy": "npm run assets && wrangler deploy"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "wrangler": "4.169.0",
    "ws": "8.23.1"
  }
}
